# Ripgrep Configuration Example
# Copia este archivo a ~/.ripgreprc para usarlo
# Luego exporta: export RIPGREP_CONFIG_PATH=~/.ripgreprc

# ============================================
# COLORES
# ============================================

# Colores para números de línea
--colors=line:fg:yellow
--colors=line:style:bold

# Colores para rutas de archivos
--colors=path:fg:green
--colors=path:style:bold

# Colores para coincidencias
--colors=match:fg:red
--colors=match:style:bold

# Colores para columnas
--colors=column:fg:blue

# ============================================
# COMPORTAMIENTO DE BÚSQUEDA
# ============================================

# Smart-case: case-insensitive si el patrón es todo minúsculas,
# case-sensitive si hay mayúsculas
--smart-case

# Mostrar números de línea
--line-number

# Ordenar resultados por ruta de archivo
--sort=path

# ============================================
# ARCHIVOS Y DIRECTORIOS
# ============================================

# Seguir enlaces simbólicos
--follow

# Buscar en archivos ocultos (archivos que empiezan con .)
--hidden

# Búsqueda multilínea permitida (descomenta si lo necesitas)
# --multiline

# ============================================
# IGNORAR PATRONES
# ============================================

# Directorios de control de versiones
--glob=!.git/*
--glob=!.svn/*
--glob=!.hg/*

# Directorios de dependencias
--glob=!node_modules/*
--glob=!bower_components/*
--glob=!vendor/*

# Entornos virtuales de Python
--glob=!venv/*
--glob=!.venv/*
--glob=!env/*
--glob=!.env/*
--glob=!virtualenv/*

# Directorios de build y cache
--glob=!build/*
--glob=!dist/*
--glob=!.cache/*
--glob=!__pycache__/*
--glob=!.pytest_cache/*
--glob=!.mypy_cache/*
--glob=!.ruff_cache/*
--glob=!*.egg-info/*

# Archivos compilados
--glob=!*.pyc
--glob=!*.pyo
--glob=!*.so
--glob=!*.o
--glob=!*.a
--glob=!*.class
--glob=!*.jar

# Archivos de configuración de IDE
--glob=!.idea/*
--glob=!.vscode/*
--glob=!*.swp
--glob=!*.swo
--glob=!*~

# Logs
--glob=!*.log
--glob=!logs/*

# Archivos de sistema
--glob=!.DS_Store
--glob=!Thumbs.db

# Coverage reports
--glob=!.coverage
--glob=!coverage/*
--glob=!htmlcov/*

# Documentación generada
--glob=!docs/_build/*
--glob=!site/*

# ============================================
# TIPOS DE ARCHIVO PERSONALIZADOS
# ============================================

# Puedes definir tipos personalizados de archivos
# Formato: --type-add 'nombre:patrón'

# Ejemplo: Agregar tipo para archivos de configuración
--type-add=config:*.{conf,config,cfg,ini,toml,yaml,yml,json}

# Ejemplo: Agregar tipo para archivos de documentación
--type-add=docs:*.{md,rst,txt,adoc}

# Ejemplo: Agregar tipo para templates
--type-add=templates:*.{j2,jinja,jinja2,tmpl,tpl}

# Ejemplo: Agregar tipo para scripts de shell
--type-add=shell:*.{sh,bash,zsh,fish}

# ============================================
# OPCIONES DE SALIDA
# ============================================

# Mostrar contexto (líneas alrededor de cada coincidencia)
# Descomenta y ajusta según prefieras
# --context=2
# --before-context=2
# --after-context=2

# Formato de salida
# Opciones: line, json, compact
# --json

# Mostrar estadísticas al final
# --stats

# ============================================
# RENDIMIENTO
# ============================================

# Número de threads (por defecto usa todos los cores)
# --threads=4

# Tamaño máximo de archivo a buscar (en bytes)
# Por defecto no hay límite
# --max-filesize=5M

# ============================================
# OTROS
# ============================================

# Incluir/excluir archivos por tipo
# Ejemplos de uso con --type-add definidos arriba:
# rg -t config "patrón"     # Buscar solo en archivos de config
# rg -T config "patrón"     # Buscar excepto en archivos de config

# ============================================
# CONFIGURACIÓN RECOMENDADA PARA PROYECTOS
# ============================================

# Para proyectos Python:
# --glob=!*.pyc
# --glob=!__pycache__/*
# --glob=!.venv/*
# --glob=!.pytest_cache/*

# Para proyectos JavaScript/Node:
# --glob=!node_modules/*
# --glob=!dist/*
# --glob=!build/*
# --glob=!.next/*

# Para proyectos con Docker:
# --glob=!.docker/*
# --glob=!.devcontainer/*

# ============================================
# NOTAS DE USO
# ============================================

# 1. Para usar esta configuración:
#    cp .ripgreprc.example ~/.ripgreprc
#    echo 'export RIPGREP_CONFIG_PATH=~/.ripgreprc' >> ~/.bashrc
#    source ~/.bashrc

# 2. Puedes sobrescribir cualquier opción en la línea de comandos:
#    rg --no-hidden "patrón"  # Ignora la opción --hidden del config

# 3. Ver configuración actual:
#    rg --debug "patrón" 2>&1 | head -20

# 4. Listar tipos de archivo disponibles:
#    rg --type-list

# 5. Buscar en tipos específicos:
#    rg -t py "def "        # Solo Python
#    rg -t py -t js "var"   # Python y JavaScript
#    rg -T test "bug"       # Excluir archivos de test

# 6. Ver ayuda:
#    rg --help
